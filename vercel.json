{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.js"
        }
    ],
    "env": {
        "MONGODB_URI": "@mongodb_uri",
        "EMAIL_USER": "@email_user",
        "EMAIL_PASS": "@email_pass"
    }
}